import std.math
import std.mesh
import std.anim
import std.color

background = [0.035, 0.045, 0.060, 1]
mesh axes = [
    stroke{alpha{0.35} LIGHT_GRAY} Line(LEFT * 4, RIGHT * 4),
    stroke{alpha{0.35} LIGHT_GRAY} Line(DOWN * 2.25, UP * 2.25)
]
mesh curve = stroke{CYAN} ExplicitFunc(|x| sin(x), [-5, 5, 160])
mesh tangent = stroke{YELLOW} Line([0.4, 0.4, 0], [2.7, 1.7, 0])
mesh focus = fill{YELLOW} Dot([1.5708, 1, 0])

slide "Sine curve"
play Set()
